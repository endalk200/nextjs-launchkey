{
	"name": "@app/database",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "drizzle-kit migrate --config drizzle.migrate.config.ts",
		"db:migrate:deploy": "drizzle-kit migrate --config drizzle.migrate.config.ts",
		"db:studio": "drizzle-kit studio --config drizzle.migrate.config.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@effect/sql-pg": "4.0.0-beta.101",
		"dotenv": "^17.2.3",
		"drizzle-orm": "1.0.0-rc.4",
		"effect": "4.0.0-beta.101",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@app/biome-config": "*",
		"@app/typescript-config": "*",
		"@effect/vitest": "4.0.0-beta.101",
		"@testcontainers/postgresql": "12.0.1",
		"@types/node": "^22.15.3",
		"@types/pg": "^8.15.6",
		"drizzle-kit": "1.0.0-rc.4",
		"testcontainers": "12.0.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
