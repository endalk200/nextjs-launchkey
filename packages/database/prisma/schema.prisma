generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("posts")
}
