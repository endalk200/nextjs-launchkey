{
	"name": "app",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
