{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"globalPassThroughEnv": [
		"AUTH_EMAIL_FROM",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"DATABASE_URL",
		"GITHUB_SHA",
		"NEXT_OTEL_VERBOSE",
		"NEXT_PUBLIC_APP_URL",
		"NEXT_PUBLIC_POSTHOG_*",
		"OTEL_*",
		"POSTHOG_*",
		"RESEND_API_KEY",
		"VERCEL_ENV",
		"VERCEL_GIT_COMMIT_SHA"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env", "$TURBO_ROOT$/.env.example"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"],
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {},
		"test:storybook": {
			"cache": false
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"build-storybook": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env", "$TURBO_ROOT$/.env.example"],
			"outputs": ["storybook-static/**"]
		},
		"test:integration": {
			"dependsOn": ["^test:integration"],
			"cache": false
		},
		"db:generate": {
			"cache": false,
			"outputs": ["drizzle/**"]
		},
		"test:e2e": {
			"dependsOn": ["build", "^build"],
			"cache": false
		},
		"test:e2e:headed": {
			"dependsOn": ["build", "^build"],
			"cache": false
		},
		"test:e2e:ui": {
			"dependsOn": ["build", "^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
