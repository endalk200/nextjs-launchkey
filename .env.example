# Copy this file to .env at the repository root. Do not create package-local
# .env files: Next.js, Playwright, Storybook, Vitest, and Drizzle all load this
# one file. Variables supplied by the shell, CI, or hosting platform take
# precedence over values in .env.
#
# Full reference: docs/environment-variables.md

# ---------------------------------------------------------------------------
# Required application configuration
# ---------------------------------------------------------------------------

# PostgreSQL connection URL used by the application and migration commands.
DATABASE_URL="postgresql://launchkey:launchkey@localhost:5432/launchkey?schema=public"

# Better Auth's server-side signing/encryption secret. Generate a unique value
# of at least 32 random characters; never expose it with a NEXT_PUBLIC_ prefix.
BETTER_AUTH_SECRET="replace-with-a-strong-secret-at-least-32-characters"

# Canonical server URL used by Better Auth for callbacks and trusted origins.
BETTER_AUTH_URL="http://localhost:3000"

# Public canonical application URL embedded in the browser bundle.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Verified sender used for authentication email.
AUTH_EMAIL_FROM="LaunchKey <auth@example.com>"

# Resend server API key used to send authentication email.
RESEND_API_KEY="re_..."

# ---------------------------------------------------------------------------
# Browser PostHog: analytics, session replay, errors, and trace correlation
# ---------------------------------------------------------------------------

# Enabling the public project token enables all browser PostHog features.
# This project token is designed to be public; it is not a personal API key.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="<project-token>"

# Browser ingestion host. The /insights reverse proxy is the recommended
# default for this app; use https://eu.i.posthog.com for an EU direct setup.
# Default: /insights
# NEXT_PUBLIC_POSTHOG_HOST="/insights"

# PostHog application host used to build links from error tracking.
# Default: https://us.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST="https://us.posthog.com"

# ---------------------------------------------------------------------------
# Server PostHog: exception capture
# ---------------------------------------------------------------------------

# Optional server-only token override. If omitted, the server reuses
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN.
# POSTHOG_PROJECT_TOKEN="<project-token>"

# PostHog event ingestion host for server-side exceptions.
# Default: https://us.i.posthog.com
# POSTHOG_HOST="https://us.i.posthog.com"

# ---------------------------------------------------------------------------
# OpenTelemetry traces and logs
# ---------------------------------------------------------------------------

# Base OTLP/HTTP endpoint. The app appends /v1/traces and /v1/logs when the
# signal-specific endpoints below are omitted.
# Default: http://localhost:4318
# Local Belfry example:
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:27686"

# Signal-specific endpoints override the base endpoint. PostHog Cloud uses /i/
# in these paths, so set both when exporting directly to PostHog.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://us.i.posthog.com/i/v1/traces"
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="https://us.i.posthog.com/i/v1/logs"

# Comma-separated Key=Value request headers. Direct PostHog OTLP export uses
# the project token as a Bearer token. Keep these server-only.
# OTEL_EXPORTER_OTLP_TRACES_HEADERS="Authorization=Bearer <project-token>"
# OTEL_EXPORTER_OTLP_LOGS_HEADERS="Authorization=Bearer <project-token>"

# Deprecated compatibility aliases; use the plural *_HEADERS variables.
# OTEL_EXPORTER_OTLP_TRACES_HEADER="Authorization=Bearer <project-token>"
# OTEL_EXPORTER_OTLP_LOGS_HEADER="Authorization=Bearer <project-token>"

# Resource metadata shown on every trace and log.
# Default service name: nextjs-launchkey-web
# OTEL_SERVICE_NAME="nextjs-launchkey-web"
# OTEL_SERVICE_VERSION="<release-or-git-sha>"
# OTEL_DEPLOYMENT_ENVIRONMENT="development"

# Standard OTel root sampler. Default: parentbased_always_on.
# Values: always_off, always_on, parentbased_always_on,
# parentbased_traceidratio, traceidratio.
# OTEL_TRACES_SAMPLER="parentbased_traceidratio"
# Ratio from 0 through 1; used by the ratio samplers. Default: 1.
# OTEL_TRACES_SAMPLER_ARG="1"

# Next.js diagnostic switch. Use only while debugging instrumentation because
# it emits a large number of internal framework spans.
# NEXT_OTEL_VERBOSE=1

# ---------------------------------------------------------------------------
# PostHog source maps and release identity
# ---------------------------------------------------------------------------

# Personal API key used only at build time to upload source maps. This is a
# secret and must never use a NEXT_PUBLIC_ prefix.
# POSTHOG_API_KEY="<personal-api-key>"

# Numeric PostHog project ID paired with POSTHOG_API_KEY.
# POSTHOG_PROJECT_ID="<project-id>"

# PostHog application host used by the source-map uploader.
# Default: https://us.posthog.com
# POSTHOG_UI_HOST="https://us.posthog.com"

# Shared release identifier attached to exceptions, spans, and source maps.
# Falls back to VERCEL_GIT_COMMIT_SHA, then GITHUB_SHA.
# POSTHOG_RELEASE_VERSION="<release-or-git-sha>"

# true: require credentials and upload in production builds.
# false: disable uploads even when credentials are present.
# Unset: upload in production when both credentials are present.
# POSTHOG_SOURCE_MAPS_ENABLED="true"

# ---------------------------------------------------------------------------
# Runtime/CI metadata (normally supplied by the platform, not local .env)
# ---------------------------------------------------------------------------

# NODE_ENV="development"
# CI="true"
# VERCEL_ENV="production"
# VERCEL_GIT_COMMIT_SHA="<git-sha>"
# GITHUB_SHA="<git-sha>"
# NEXT_RUNTIME="nodejs"
